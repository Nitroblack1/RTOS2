[core]
	bare = false
	repositoryformatversion = 0
	filemode = true
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/Nitroblack1/RTOS.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "dev"]
	remote = origin
	merge = refs/heads/main
[branch "develop"]
	github-pr-base-branch = "Nitroblack1#RTOS#main"
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/develop
	github-pr-base-branch = "Nitroblack1#RTOS#main"
[branch "sub"]
	github-pr-base-branch = "Nitroblack1#RTOS#develop"
	vscode-merge-base = origin/develop
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
